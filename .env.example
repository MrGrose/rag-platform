APP_ENV=development
LOG_LEVEL=INFO
API_KEY=
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5436/rag
REDIS_URL=redis://localhost:6380/0
ARQ_REDIS_URL=redis://localhost:6380/1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-documents
RATE_LIMIT_PER_MINUTE=120
ALLOW_OPEN_API=false
ALLOW_FAKE_PROVIDERS=true
RATE_LIMIT_FAIL_CLOSED=false

# Providers: fake keeps the stack self-contained; bge_m3 and bge_reranker
# require the optional extra: uv sync --extra local
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DEVICE=cpu
EMBEDDINGS_BATCH_SIZE=16
RERANKER_PROVIDER=fake
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_RETRIES=2
RAG_MIN_RELEVANCE_SCORE=0.2
